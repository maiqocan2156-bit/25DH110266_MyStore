
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - QUẢN TRỊ WEBSITE</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle"
                        data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                @Html.ActionLink(
                    "My Store",
                    "Index",
                    "Home",
                    new { area = "Admin" },
                    new { @class = "navbar-brand" })
            </div>

            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li>
                        @Html.ActionLink("Trang chủ", "Index", "Home",
                            new { area = "Admin" }, null)
                    </li>
                    <li>
                        @Html.ActionLink("Danh mục", "Index", "Categories",
                            new { area = "Admin" }, null)
                    </li>
                    <li>
                        @Html.ActionLink("Sản phẩm", "Index", "Products",
                            new { area = "Admin" }, null)
                    </li>
                    <li>
                        @Html.ActionLink("Khách hàng", "Index", "Customers",
                            new { area = "Admin" }, null)
                    </li>
                    <li>
                        @Html.ActionLink("Đơn hàng", "Index", "Orders",
                            new { area = "Admin" }, null)
                    </li>
                    <li>
                        @Html.ActionLink("Tài khoản Admin", "Index", "AdminUsers",
                            new { area = "Admin" }, null)
                    </li>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    @if (Session["Username"] != null)
                    {
                        <li>
                            <a href="javascript:void(0)">
                                Xin chào, @Session["Username"]
                            </a>
                        </li>
                        <li>
                            @Html.ActionLink(
                                "Đăng xuất",
                                "Logout",
                                "Account",
                                new { area = "Admin" },
                                null)
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My Store</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("Scripts", required: false)
</body>
</html>
