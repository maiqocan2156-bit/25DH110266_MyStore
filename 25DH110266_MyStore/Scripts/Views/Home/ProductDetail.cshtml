
@model _25DH110266_MyStore.Models.ViewModel.ProductDetailVM

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    var product = Model.Product;
    var topProducts = Model.TopProducts ?? new List<_25DH110266_MyStore.Models.Product>();
    var totalPages = Model.TotalPages;
    var currentPage = Model.Page < 1 ? 1 : Model.Page;
    var pagedTopProducts = topProducts
        .Skip((currentPage - 1) * 3)
        .Take(3)
        .ToList();
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-5">
            @if (!String.IsNullOrWhiteSpace(product.ProductImage))
            {
                <img src="@(product.ProductImage.StartsWith("http")
                    ? product.ProductImage
                    : Url.Content("~/Content/images/" + product.ProductImage))"
                     alt="@product.ProductName"
                     style="width:100%; max-height:350px; object-fit:contain;"
                     onerror="this.style.display='none';" />
            }
        </div>

        <div class="col-md-7">
            <h2>@product.ProductName</h2>

            <h4 class="text-danger">
                @String.Format("{0:N0} đ", product.ProductPrice)
            </h4>

            <p>
                <strong>Danh mục:</strong>
                @(product.Category != null
                    ? product.Category.CategoryName
                    : "Chưa phân loại")
            </p>

            <p>
                <strong>Mô tả:</strong>
                @product.ProductDescription
            </p>

            <p>
                <strong>Số lượng đã bán:</strong>
                @(product.OrderDetails != null
                    ? product.OrderDetails.Sum(od => od.Quantity)
                    : 0)
            </p>

            <hr />

            <h5>Mua sản phẩm</h5>

            @using (Html.BeginForm("AddToCart", "Home", FormMethod.Post))
            {
                @Html.Hidden("id", product.ProductID)

                <div class="form-group">
                    <label for="quantity">Số lượng:</label>
                    <input type="number"
                           id="quantity"
                           name="quantity"
                           value="1"
                           min="1"
                           class="form-control"
                           style="width:100px;" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Thêm vào giỏ hàng
                </button>
            }

            @if (TempData["CartMessage"] != null)
            {
                <div class="alert alert-success mt-3">
                    @TempData["CartMessage"]
                </div>
            }
        </div>
    </div>

    <hr class="my-5" />

    <h3>Sản phẩm tương tự</h3>

    <div class="row">
        @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
        {
            foreach (var item in Model.RelatedProducts)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100">
                        @if (!String.IsNullOrWhiteSpace(item.ProductImage))
                        {
                            <img src="@(item.ProductImage.StartsWith("http")
                                ? item.ProductImage
                                : Url.Content("~/Content/images/" + item.ProductImage))"
                                 class="card-img-top"
                                 alt="@item.ProductName"
                                 style="height:180px; object-fit:contain;" />
                        }

                        <div class="card-body">
                            <h5 class="card-title">@item.ProductName</h5>
                            <p class="text-danger font-weight-bold">
                                @String.Format("{0:N0} đ", item.ProductPrice)
                            </p>
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })"
                               class="btn btn-outline-primary">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="ml-3">Chưa có sản phẩm tương tự.</p>
        }
    </div>

    <hr class="my-5" />

    <h3>Top Deals</h3>

    <div class="row">
        @if (pagedTopProducts.Any())
        {
            foreach (var item in pagedTopProducts)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (!String.IsNullOrWhiteSpace(item.ProductImage))
                        {
                            <img src="@(item.ProductImage.StartsWith("http")
                                ? item.ProductImage
                                : Url.Content("~/Content/images/" + item.ProductImage))"
                                 class="card-img-top"
                                 alt="@item.ProductName"
                                 style="height:200px; object-fit:contain;" />
                        }

                        <div class="card-body">
                            <h5 class="card-title">@item.ProductName</h5>
                            <p class="text-danger font-weight-bold">
                                @String.Format("{0:N0} đ", item.ProductPrice)
                            </p>
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })"
                               class="btn btn-outline-primary">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="ml-3">Chưa có sản phẩm Top Deals.</p>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="text-center mt-3 mb-5">
            @for (int i = 1; i <= totalPages; i++)
            {
                <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID, page = i })"
                   class="btn @(i == currentPage ? "btn-primary" : "btn-outline-primary") mr-1">
                    @i
                </a>
            }
        </div>
    }
</div>
