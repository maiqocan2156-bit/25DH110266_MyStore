
@model IEnumerable<_25DH110266_MyStore.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Quản lý danh mục</h2>
<hr />

<p>
    @Html.ActionLink("+ Thêm danh mục mới", "Create", null,
        new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Tên danh mục</th>
            <th style="width: 240px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID },
                        new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID },
                        new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID },
                        new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
