
@model _25DH110266_MyStore.Models.User

@{
    ViewBag.Title = "Sửa tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Sửa tài khoản Admin</h2>
<hr />

@using (Html.BeginForm(
    "Edit",
    "AdminUsers",
    new { id = Model.Username },
    FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("id", Model.Username)

    <div class="form-horizontal">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="form-group">
            <label class="control-label col-md-2">Tên đăng nhập</label>
            <div class="col-md-10">
                <input type="text" class="form-control"
                       value="@Model.Username" readonly />
            </div>
        </div>

        <div class="form-group">
            <label for="password" class="control-label col-md-2">
                Mật khẩu mới
            </label>
            <div class="col-md-10">
                <input type="password" id="password" name="password"
                       class="form-control"
                       autocomplete="new-password" />

                <p class="help-block">
                    Để trống nếu không muốn đổi mật khẩu.
                </p>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary">
                    Lưu thay đổi
                </button>

                @Html.ActionLink(
                    "Quay lại",
                    "Index",
                    null,
                    new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}

