
@model _25DH110266_MyStore.Models.User

@{
    ViewBag.Title = "Xóa tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Xóa tài khoản Admin</h2>
<hr />

<div class="alert alert-warning">
    Bạn có chắc chắn muốn xóa tài khoản này không?
</div>

<dl class="dl-horizontal">
    <dt>Tên đăng nhập</dt>
    <dd>@Model.Username</dd>

    <dt>Vai trò</dt>
    <dd>@Model.UserRole</dd>
</dl>

@if (ViewBag.IsCurrentUser == true)
{
    <div class="alert alert-danger">
        Bạn không thể xóa tài khoản Admin đang đăng nhập.
    </div>
}
else
{
    using (Html.BeginForm(
        "Delete",
        "AdminUsers",
        new { id = Model.Username },
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Xác nhận xóa
        </button>
    }
}

@Html.ActionLink(
    "Quay lại",
    "Index",
    null,
    new { @class = "btn btn-default" })

