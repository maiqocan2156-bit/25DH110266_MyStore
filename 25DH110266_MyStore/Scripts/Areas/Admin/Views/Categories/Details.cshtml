
@model _25DH110266_MyStore.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Chi tiết danh mục</h2>
<hr />

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>Thông tin danh mục</strong>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Tên danh mục</dt>
            <dd>@Html.DisplayFor(model => model.CategoryName)</dd>
        </dl>
    </div>
</div>

<p>
    @Html.ActionLink("Chỉnh sửa", "Edit",
        new { id = Model.CategoryID },
        new { @class = "btn btn-warning" })

    @Html.ActionLink("Quay lại danh sách", "Index",
        null, new { @class = "btn btn-default" })
</p>
