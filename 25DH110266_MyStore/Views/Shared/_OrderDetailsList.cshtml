
@model IEnumerable<_25DH110266_MyStore.Models.OrderDetail>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>STT</th>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = 1;
            }

            @foreach (var detail in Model)
            {
                <tr>
                    <td>@stt</td>
                    <td>
                        @(detail.Product != null
                            ? detail.Product.ProductName
                            : "Không có thông tin sản phẩm")
                    </td>
                    <td>@detail.Quantity</td>
                    <td>@detail.UnitPrice.ToString("N0") VNĐ</td>
                    <td>
                        @(detail.TotalPrice.HasValue
                            ? detail.TotalPrice.Value.ToString("N0")
                            : "0") VNĐ
                    </td>
                </tr>

                stt++;
            }
        </tbody>
    </table>
}
else
{
    <p>Đơn hàng chưa có thông tin chi tiết sản phẩm.</p>
}
