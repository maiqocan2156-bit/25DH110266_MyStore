
@model IEnumerable<_25DH110266_MyStore.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Quản lý đơn hàng</h2>

<hr />

<p>
    @Html.ActionLink("Thêm đơn hàng", "Create", null,
        new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Ngày đặt hàng</th>
            <th>Tổng tiền</th>
            <th>Trạng thái thanh toán</th>
            <th>Địa chỉ giao hàng</th>
            <th>Tên khách hàng</th>
            <th style="min-width: 190px;">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        @item.TotalAmount.ToString("N0") VNĐ
                    </td>

                    <td>
                        @item.PaymentStatus
                    </td>

                    <td>
                        @item.AddressDelivery
                    </td>

                    <td>
                        @(item.Customer != null
                            ? item.Customer.CustomerName
                            : "Chưa có thông tin")
                    </td>

                    <td>
                        @Html.ActionLink("Sửa", "Edit",
                            new { id = item.OrderID },
                            new { @class = "btn btn-warning btn-sm" })

                        @Html.ActionLink("Chi tiết", "Details",
                            new { id = item.OrderID },
                            new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Xóa", "Delete",
                            new { id = item.OrderID },
                            new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    Chưa có đơn hàng nào.
                </td>
            </tr>
        }
    </tbody>
</table>
