
@model PagedList.IPagedList<_25DH110266_MyStore.Models.Order>
@using PagedList.Mvc

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>QUẢN LÝ ĐƠN HÀNG</h2>

<hr />

@* TÌM KIẾM ĐƠN HÀNG *@

@using (Html.BeginForm("Index", "Orders", FormMethod.Get))
{
    <div class="row" style="margin-bottom:15px;">

        <div class="col-md-3">
            <input type="text"
                   name="customerName"
                   class="form-control"
                   placeholder="Tên khách hàng"
                   value="@Request.QueryString["customerName"]" />
        </div>

        <div class="col-md-3">
            <select name="paymentStatus" class="form-control">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Chưa thanh toán"
                        @(Request.QueryString["paymentStatus"] == "Chưa thanh toán" ? "selected" : "")>
                    Chưa thanh toán
                </option>
                <option value="Đã thanh toán"
                        @(Request.QueryString["paymentStatus"] == "Đã thanh toán" ? "selected" : "")>
                    Đã thanh toán
                </option>
            </select>
        </div>

        <div class="col-md-3">
            <input type="date"
                   name="orderDate"
                   class="form-control"
                   value="@Request.QueryString["orderDate"]" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">
                Tìm kiếm
            </button>

            @Html.ActionLink("Làm mới", "Index", null,
                     new { @class = "btn btn-default" })
        </div>

    </div>
}

<hr />

@* DANH SÁCH ĐƠN HÀNG *@

@if (Model != null && Model.Any())
{
    <p>
        Tổng số đơn hàng:
        <strong>@Model.TotalItemCount</strong>
    </p>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Mã đơn hàng</th>
                    <th>Ngày đặt hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Trạng thái đơn hàng</th>
                    <th>Địa chỉ giao hàng</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            #@item.OrderID
                        </td>

                        <td>
                            @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @(item.Customer != null
                                ? item.Customer.CustomerName
                                : "Chưa có thông tin")
                        </td>

                        <td>
                            @item.TotalAmount.ToString("N0") VNĐ
                        </td>

                        <td>
                            @item.PaymentStatus
                        </td>

                        <td>
                            @item.OrderStatus
                        </td>

                        <td>
                            @item.AddressDelivery
                        </td>

                        <td>
                            @Html.ActionLink(
                                     "Chi tiết đơn hàng",
                                     "Details",
                                     new { id = item.OrderID },
                                     new { @class = "btn btn-info btn-sm" })
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}
else
{
    <div class="alert alert-warning text-center">
        <strong>KHÔNG CÓ</strong> đơn hàng phù hợp.
    </div>
}

@* PHÂN TRANG *@

<div class="text-center">

    @Html.PagedListPager(Model, page => Url.Action("Index", new
    {
        page,
        customerName = Request.QueryString["customerName"],
        paymentStatus = Request.QueryString["paymentStatus"],
        orderDate = Request.QueryString["orderDate"]
    }))

</div>
