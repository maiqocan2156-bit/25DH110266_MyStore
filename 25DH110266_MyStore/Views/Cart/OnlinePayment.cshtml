
@{
    ViewBag.Title = "Thanh toán trực tuyến";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card p-4">
        <h2 class="text-center">Thanh toán trực tuyến</h2>
        <p class="text-center">Chọn phương thức thanh toán của bạn</p>

        @using (Html.BeginForm("Checkout", "Cart", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            foreach (var id in (List<int>)ViewBag.SelectedProductIds)
            {
                <input type="hidden" name="selectedProductIds" value="@id" />
            }

            <input type="hidden" name="deliveryMethod"
                   value="@ViewBag.DeliveryMethod" />

            <input type="hidden" name="addressDelivery"
                   value="@ViewBag.AddressDelivery" />

            <input type="hidden" name="paymentMethod"
                   value="Thanh toán trực tuyến" />

            <input type="hidden" id="onlineMethod"
                   name="onlineMethod" />

            <h5 class="mt-3">1. Chọn hình thức</h5>

            <div class="form-group">
                <label>
                    <input type="radio" name="paymentType"
                           value="wallet" />
                    Ví điện tử
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="radio" name="paymentType"
                           value="card" />
                    Thẻ ngân hàng
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="radio" name="paymentType"
                           value="qr" />
                    Thanh toán bằng QR Code
                </label>
            </div>

            <hr />

            <div id="walletArea" style="display:none">
                <h5>2. Chọn ví điện tử</h5>

                <label class="d-block">
                    <input type="radio" name="wallet"
                           value="MoMo" />
                    MoMo
                </label>

                <label class="d-block">
                    <input type="radio" name="wallet"
                           value="ZaloPay" />
                    ZaloPay
                </label>
            </div>

            <div id="cardArea" style="display:none">
                <h5>Thanh toán bằng thẻ ngân hàng</h5>
                <p>Chức năng thanh toán thẻ đang ở chế độ mô phỏng.</p>
            </div>

            <div id="qrArea" style="display:none"
                 class="text-center">
                <h5>Mã QR thanh toán trực tuyến</h5>

                <img id="onlineQR"
                     src=""
                     alt="QR minh họa"
                     style="width:250px;height:250px;
                            border:1px solid #ddd;padding:10px;" />

                <p class="text-muted">
                    QR minh họa, không dùng để chuyển tiền thật.
                </p>
            </div>

            <hr />

            <button type="submit" id="confirmButton"
                    class="btn btn-primary" disabled>
                Xác nhận thanh toán
            </button>

            <a href="@Url.Action("Index", "Cart")"
               class="btn btn-secondary">
                Quay lại
            </a>
        }

        <p class="text-muted text-center mt-3">
            Hệ thống thanh toán mô phỏng, chưa kết nối cổng thanh toán thật.
        </p>
    </div>
</div>

<script>
    const walletArea = document.getElementById("walletArea");
    const cardArea = document.getElementById("cardArea");
    const qrArea = document.getElementById("qrArea");
    const onlineQR = document.getElementById("onlineQR");
    const onlineMethod = document.getElementById("onlineMethod");
    const confirmButton = document.getElementById("confirmButton");

    function updateQR(content) {
        onlineQR.src =
            "https://api.qrserver.com/v1/create-qr-code/?size=250x250&data="
            + encodeURIComponent("MYSTORE-DEMO-" + content);
    }

    document.querySelectorAll('input[name="paymentType"]')
        .forEach(function (radio) {
            radio.addEventListener("change", function () {
                walletArea.style.display = "none";
                cardArea.style.display = "none";
                qrArea.style.display = "none";

                onlineMethod.value = "";
                confirmButton.disabled = true;

                document.querySelectorAll('input[name="wallet"]')
                    .forEach(x => x.checked = false);

                if (this.value === "wallet") {
                    walletArea.style.display = "block";
                }

                if (this.value === "card") {
                    cardArea.style.display = "block";
                    onlineMethod.value = "Thẻ ngân hàng";
                    confirmButton.disabled = false;
                }

                if (this.value === "qr") {
                    qrArea.style.display = "block";
                    onlineMethod.value = "QR Code";
                    updateQR("ONLINE-PAYMENT");
                    confirmButton.disabled = false;
                }
            });
        });

    document.querySelectorAll('input[name="wallet"]')
        .forEach(function (radio) {
            radio.addEventListener("change", function () {
                onlineMethod.value = "Ví điện tử - " + this.value;
                qrArea.style.display = "block";
                updateQR(this.value);
                confirmButton.disabled = false;
            });
        });
</script>
