
@model _25DH110266_MyStore.Models.Customer

@{
    ViewBag.Title = "Thêm khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Thêm khách hàng mới</h2>
<hr />

@using (Html.BeginForm("Create", "Customers", FormMethod.Post, new { area = "Admin" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Thông tin khách hàng</h4>
        <hr />

        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        @if (ViewBag.HasUsers == false)
        {
            <div class="alert alert-warning">
                Chưa có tài khoản nào trong hệ thống.
                Vui lòng tạo tài khoản trước khi thêm khách hàng.
            </div>
        }

        <div class="form-group">
            @Html.LabelFor(
                model => model.CustomerName,
                "Họ và tên",
                new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.EditorFor(
                    model => model.CustomerName,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control",
                            placeholder = "Nhập họ và tên..."
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.CustomerName,
                    "",
                    new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(
                model => model.CustomerPhone,
                "Số điện thoại",
                new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.EditorFor(
                    model => model.CustomerPhone,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control",
                            placeholder = "Nhập số điện thoại..."
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.CustomerPhone,
                    "",
                    new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(
                model => model.CustomerEmail,
                "Email",
                new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.EditorFor(
                    model => model.CustomerEmail,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control",
                            placeholder = "Nhập địa chỉ email..."
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.CustomerEmail,
                    "",
                    new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(
                model => model.CustomerAddress,
                "Địa chỉ",
                new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.EditorFor(
                    model => model.CustomerAddress,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control",
                            placeholder = "Nhập địa chỉ..."
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.CustomerAddress,
                    "",
                    new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(
                model => model.Username,
                "Tài khoản",
                new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.DropDownListFor(
                    model => model.Username,
                    ViewBag.Username as SelectList,
                    "-- Chọn tài khoản --",
                    new
                    {
                        @class = "form-control",
                        required = "required"
                    })

                @Html.ValidationMessageFor(
                    model => model.Username,
                    "",
                    new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit"
                        class="btn btn-primary"
                        @(ViewBag.HasUsers == false ? "disabled=\"disabled\"" : "")>
                    Thêm khách hàng
                </button>

                @Html.ActionLink(
                    "Quay lại danh sách",
                    "Index",
                    "Customers",
                    new { area = "Admin" },
                    new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
