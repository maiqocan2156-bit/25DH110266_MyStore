
@model IEnumerable<_25DH110266_MyStore.Models.Customer>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Quản lý khách hàng</h2>

<hr />

<p>
    @Html.ActionLink("Thêm khách hàng mới", "Create", null,
        new { @class = "btn btn-primary" })
</p>

@using (Html.BeginForm("Index", "Customers", FormMethod.Get))
{
    <div class="form-inline" style="margin-bottom: 20px;">
        <input type="text"
               name="searchString"
               value="@ViewBag.CurrentFilter"
               class="form-control"
               placeholder="Nhập tên, email hoặc số điện thoại..."
               style="width: 300px; max-width: 100%;" />

        <button type="submit" class="btn btn-success">
            Tìm kiếm
        </button>

        @Html.ActionLink("Làm mới", "Index", null,
            new { @class = "btn btn-default" })
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Html.ActionLink(
                    "Tên khách hàng",
                    "Index",
                    new
                    {
                        sortOrder = ViewBag.NameSortParm,
                        searchString = ViewBag.CurrentFilter
                    })
            </th>
            <th>Số điện thoại</th>
            <th>Email</th>
            <th>Địa chỉ</th>
            <th>Tài khoản</th>
            <th style="min-width: 180px;">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.CustomerName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CustomerPhone)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CustomerEmail)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CustomerAddress)
                    </td>
                    <td>
                        @(item.Username ?? "")
                    </td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit",
                            new { id = item.CustomerID },
                            new { @class = "btn btn-warning btn-sm" })

                        @Html.ActionLink("Chi tiết", "Details",
                            new { id = item.CustomerID },
                            new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Xóa", "Delete",
                            new { id = item.CustomerID },
                            new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    Không tìm thấy khách hàng nào.
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int currentPage = ViewBag.CurrentPage != null
        ? (int)ViewBag.CurrentPage : 1;

    int totalPages = ViewBag.TotalPages != null
        ? (int)ViewBag.TotalPages : 0;
}

@if (totalPages > 1)
{
    <nav aria-label="Phân trang khách hàng">
        <ul class="pagination">
            @if (currentPage > 1)
            {
                <li>
                    @Html.ActionLink("« Trước", "Index", new
                    {
                        page = currentPage - 1,
                        searchString = ViewBag.CurrentFilter,
                        sortOrder = ViewBag.CurrentSort
                    })
                </li>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                {
                    <li class="active">
                        <span>@i</span>
                    </li>
                }
                else
                {
                    <li>
                        @Html.ActionLink(i.ToString(), "Index", new
                        {
                            page = i,
                            searchString = ViewBag.CurrentFilter,
                            sortOrder = ViewBag.CurrentSort
                        })
                    </li>
                }
            }

            @if (currentPage < totalPages)
            {
                <li>
                    @Html.ActionLink("Tiếp »", "Index", new
                    {
                        page = currentPage + 1,
                        searchString = ViewBag.CurrentFilter,
                        sortOrder = ViewBag.CurrentSort
                    })
                </li>
            }
        </ul>
    </nav>
}

<p>
    Trang @currentPage / @totalPages
</p>
