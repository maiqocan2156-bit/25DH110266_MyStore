
@model _25DH110266_MyStore.Models.User

@{
    ViewBag.Title = "Thêm tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Thêm tài khoản Admin</h2>
<hr />

@using (Html.BeginForm("Create", "AdminUsers", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(
                m => m.Username,
                "Tên đăng nhập",
                new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.TextBoxFor(
                    m => m.Username,
                    new
                    {
                        @class = "form-control",
                        required = "required",
                        maxlength = "100",
                        autocomplete = "off"
                    })

                @Html.ValidationMessageFor(
                    m => m.Username,
                    "",
                    new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(
                m => m.Password,
                "Mật khẩu",
                new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.PasswordFor(
                    m => m.Password,
                    new
                    {
                        @class = "form-control",
                        required = "required",
                        autocomplete = "new-password"
                    })

                @Html.ValidationMessageFor(
                    m => m.Password,
                    "",
                    new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Vai trò</label>
            <div class="col-md-10">
                <input type="text" class="form-control"
                       value="Admin" readonly />
                <p class="help-block">
                    Tài khoản được tạo tại đây sẽ có quyền Admin.
                </p>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary">
                    Thêm tài khoản
                </button>

                @Html.ActionLink(
                    "Quay lại",
                    "Index",
                    null,
                    new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}
