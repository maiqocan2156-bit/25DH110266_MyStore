
@model _25DH110266_MyStore.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Chi tiết khách hàng</h2>

<div>
    <h4>Thông tin khách hàng</h4>
    <hr />

    <dl class="dl-horizontal">
        <dt>Mã khách hàng</dt>
        <dd>@Model.CustomerID</dd>

        <dt>Họ tên</dt>
        <dd>@Model.CustomerName</dd>

        <dt>Số điện thoại</dt>
        <dd>@Model.CustomerPhone</dd>

        <dt>Email</dt>
        <dd>@Model.CustomerEmail</dd>

        <dt>Địa chỉ</dt>
        <dd>@Model.CustomerAddress</dd>

        <dt>Tên tài khoản</dt>
        <dd>@Model.Username</dd>
    </dl>
</div>

<hr />

<h3>Lịch sử đơn hàng</h3>

@Html.Partial("_CustomerOrderList", Model.Orders)

<hr />

<p>
    @Html.ActionLink("Chỉnh sửa", "Edit",
                new { id = Model.CustomerID },
                new { @class = "btn btn-warning" })

    @Html.ActionLink("Quay lại danh sách", "Index",
                null,
                new { @class = "btn btn-default" })
</p>
