
@model _25DH110266_MyStore.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Xóa danh mục</h2>

@if (ViewBag.ProductCount > 0)
{
    <div class="alert alert-danger">
        <strong>Không thể xóa danh mục này!</strong>
        <p>
            Danh mục hiện có @ViewBag.ProductCount sản phẩm.
            Vui lòng chuyển hoặc xóa các sản phẩm liên quan trước.
        </p>
    </div>
}
else
{
    <div class="alert alert-warning">
        <strong>Bạn có chắc chắn muốn xóa danh mục này không?</strong>
        <p>Thao tác này sẽ xóa danh mục khỏi cơ sở dữ liệu.</p>
    </div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>Thông tin danh mục</strong>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Tên danh mục</dt>
            <dd>@Html.DisplayFor(model => model.CategoryName)</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm("Delete", "Categories",
    new { id = Model.CategoryID }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    if (ViewBag.ProductCount == 0)
    {
        <button type="submit" class="btn btn-danger">
            Xác nhận xóa
        </button>
    }

    @Html.ActionLink("Quay lại danh sách", "Index",
            null, new { @class = "btn btn-default" })
}
