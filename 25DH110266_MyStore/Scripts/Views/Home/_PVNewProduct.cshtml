
@model PagedList.IPagedList<_25DH110266_MyStore.Models.Product>

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(item.ProductImage))
                    {
                        <img src="@(item.ProductImage.StartsWith("http")
                            ? item.ProductImage
                            : Url.Content("~/Content/images/" + item.ProductImage))"
                             alt="@item.ProductName"
                             style="height:180px; width:100%; object-fit:contain;"
                             onerror="this.style.display='none';" />
                    }

                <div class="card-body">
                    <h5 class="card-title">@item.ProductName</h5>

                    <p class="card-text">
                        @item.ProductDescription
                    </p>

                    <p class="text-danger font-weight-bold">
                        @String.Format("{0:N0} đ", item.ProductPrice)
                    </p>

                    <a href="@Url.Action("ProductDetail", "Home",
                        new { id = item.ProductID })"
                       class="btn btn-primary">
                        Xem chi tiết
                    </a>
                </div>
                </div>
            </div>
        }
    }
    else
    {
        <p>Không tìm thấy sản phẩm.</p>
    }
</div>

@if (Model != null && Model.PageCount > 1)
{
    <div class="text-center">
        @if (Model.HasPreviousPage)
        {
            <a href="@Url.Action("Index", new {
                page = Model.PageNumber - 1,
                searchTearm = Request.QueryString["searchTearm"]
            })">Trước</a>
        }

        @for (int i = 1; i <= Model.PageCount; i++)
        {
            <a href="@Url.Action("Index", new {
                page = i,
                searchTearm = Request.QueryString["searchTearm"]
            })"
               style="margin: 5px; @(i == Model.PageNumber ? "font-weight:bold;" : "")">
                @i
            </a>
        }

        @if (Model.HasNextPage)
        {
            <a href="@Url.Action("Index", new {
                page = Model.PageNumber + 1,
                searchTearm = Request.QueryString["searchTearm"]
            })">Tiếp</a>
        }
    </div>
}

