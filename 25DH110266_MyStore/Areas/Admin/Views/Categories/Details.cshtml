
@model _25DH110266_MyStore.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<h2>Chi tiết danh mục</h2>
<hr />

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>Thông tin danh mục</strong>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Tên danh mục</dt>
            <dd>@Html.DisplayFor(model => model.CategoryName)</dd>
        </dl>
    </div>
</div>

<hr />

<h3>Danh sách sản phẩm thuộc danh mục</h3>

@if (Model.Products != null && Model.Products.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Giá bán</th>
                <th>Số lượng tồn</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>@item.ProductName</td>

                    <td>
                        @item.ProductPrice.ToString("N0") VNĐ
                    </td>

                    <td>@item.Quantity</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        Danh mục này chưa có sản phẩm nào.
    </div>
}

<p>
    @Html.ActionLink("Chỉnh sửa", "Edit",
        new { id = Model.CategoryID },
        new { @class = "btn btn-warning" })

    @Html.ActionLink("Quay lại danh sách", "Index",
        null, new { @class = "btn btn-default" })
</p>
