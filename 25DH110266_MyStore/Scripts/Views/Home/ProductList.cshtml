@model IEnumerable<_25DH110266_MyStore.Models.Product>

@{
    ViewBag.Title = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <h2>@(ViewBag.CategoryName ?? "Danh sách sản phẩm")</h2>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(item.ProductImage))
                        {
                            <img src="@(item.ProductImage.StartsWith("http")
                                ? item.ProductImage
                                : Url.Content("~/Content/images/" + item.ProductImage))"
                                 alt="@item.ProductName"
                                 style="height:180px; width:100%; object-fit:contain;"
                                 onerror="this.style.display='none';" />
                        }

                        <div class="card-body">
                            <h5>@item.ProductName</h5>
                            <p>@item.ProductDescription</p>
                            <p class="text-danger">
                                @String.Format("{0:N0} đ", item.ProductPrice)
                            </p>

                            <a href="@Url.Action("ProductDetail", "Home",
                                new { id = item.ProductID })"
                               class="btn btn-primary">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p>Danh mục này chưa có sản phẩm.</p>
        }
    </div>
</div>
